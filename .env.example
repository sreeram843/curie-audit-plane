# Local prototype paths. Do not put real keys, tokens, or patient data here.
CAP_DATA_DIR=./data
CAP_SIGNING_KEY_PATH=./data/keys/ed25519.pem
CAP_VERIFYING_KEY_PATH=./data/keys/ed25519.pub
CAP_HOST=127.0.0.1
CAP_PORT=8080

# LLM adapter. Default is the deterministic stub used by tests.
# For local LM Studio (OpenAI-compatible):
# CAP_LLM_PROVIDER=openai_compatible
# CAP_LLM_BASE_URL=http://127.0.0.1:1234/v1
# CAP_LLM_MODEL=medgemma-4b-it-mlx
CAP_LLM_PROVIDER=stub
CAP_LLM_BASE_URL=http://127.0.0.1:1234/v1
CAP_LLM_MODEL=medgemma-4b-it-mlx
# CAP_LLM_API_KEY=
# CAP_LLM_TIMEOUT_SECONDS=120

# Fail-closed prototype auth. Run `curie-audit-plane setup` to generate local tokens.
# Do not commit real values.
CAP_ADMIN_TOKEN=
CAP_REVIEWER_TOKEN=
CAP_INVESTIGATOR_TOKEN=
# Console bearer token. Setup writes the matching admin token here.
VITE_CAP_AUTH_TOKEN=
